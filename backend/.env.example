# ZLabs Portal Environment Configuration Template
# Copy this file to .env and fill in the values

DEBUG=True
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Email Configuration
# --------------------
# Use django.core.mail.backends.console.EmailBackend for local testing (prints to console)
# Use django.core.mail.backends.smtp.EmailBackend for real emails
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

DEFAULT_FROM_EMAIL="ZLabs Portal <your-email@gmail.com>"
FRONTEND_URL=http://localhost:5173
